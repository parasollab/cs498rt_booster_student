# Loads the LOCKED settings of the CURRENT assignment (account, partitions,
# paths, W&B team). Sourced by every script in scripts/; you can source it too:
#
#     source scripts/cluster.env && echo "$COURSE_ACCOUNT"
#
# EVERY assignment has its own locked settings file: scripts/<assignment>.env
# in the repo, with the master copy /projects/bign/cs498/<assignment>.env on
# Delta (staff can update the master without a repo release; the master
# wins when readable). Which assignment is CURRENT comes from the one-line
# marker file scripts/CURRENT_ASSIGNMENT — staff bump it with each release,
# so after `git pull` the whole toolchain switches settings by itself.
# Overrides:
#     COURSE_ASSIGNMENT=hw1   -> load hw1.env regardless of the marker
#     COURSE_ENV_FILE=/path   -> load exactly that file
# Never put values in this file.
_cluster_env_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
_marker="${_cluster_env_dir}/CURRENT_ASSIGNMENT"
_default_assignment="hw0"
[[ -r "${_marker}" ]] && _default_assignment="$(tr -d '[:space:]' < "${_marker}")"
export COURSE_ASSIGNMENT="${COURSE_ASSIGNMENT:-${_default_assignment}}"
unset _marker _default_assignment
if [[ "${COURSE_ASSIGNMENT}" == "cluster" ]]; then
  echo "cluster.env: COURSE_ASSIGNMENT=cluster is not a valid assignment" >&2
  return 1 2>/dev/null || exit 1
fi
export COURSE_ENV_FILE="${COURSE_ENV_FILE:-/projects/bign/cs498/${COURSE_ASSIGNMENT}.env}"
if [[ -r "${COURSE_ENV_FILE}" ]]; then
  # shellcheck disable=SC1090
  source "${COURSE_ENV_FILE}"
  export COURSE_ENV_SOURCE="${COURSE_ENV_FILE}"
else
  if [[ ! -r "${_cluster_env_dir}/${COURSE_ASSIGNMENT}.env" ]]; then
    echo "cluster.env: no settings for assignment '${COURSE_ASSIGNMENT}'" >&2
    echo "  looked for: ${COURSE_ENV_FILE} and ${_cluster_env_dir}/${COURSE_ASSIGNMENT}.env" >&2
    echo "  available:  $(ls "${_cluster_env_dir}"/*.env 2>/dev/null | xargs -n1 basename | grep -v '^cluster[.]env$' | tr '\n' ' ')" >&2
    return 1 2>/dev/null || exit 1
  fi
  # shellcheck disable=SC1090
  source "${_cluster_env_dir}/${COURSE_ASSIGNMENT}.env"
  export COURSE_ENV_SOURCE="${_cluster_env_dir}/${COURSE_ASSIGNMENT}.env"
fi
unset _cluster_env_dir

# ---------------------------------------------------------------------------
# CS 498 — LOCKED settings for HW0 on NCSA Delta. Staff-owned. Do not edit.
#
# Master copy (what the cluster scripts actually load):
#     /projects/bign/cs498/hw0.env
# This repo copy is kept identical; it is the fallback on laptops
# where the master is unreachable. `source scripts/cluster.env` picks the
# right one and exports everything below. Later assignments ship their own
# <assignment>.env — follow each handout's instructions.
#
# HW0 Step 2 asks you to rediscover these values with cluster commands
# (the Gradescope quiz's cluster part).
# ---------------------------------------------------------------------------
export COURSE_ENV_VERSION="2026-09-02"

# --- Cluster / login -------------------------------------------------------
export COURSE_CLUSTER="delta"                                  # Delta, NOT DeltaAI
export COURSE_LOGIN_HOST="login.delta.ncsa.illinois.edu"       # round-robin to dt-login01..04

# --- Allocation ------------------------------------------------------------
export COURSE_PROJECT="bign"                 # 4-letter project code (file-system paths)
export COURSE_PROJECT_GROUP="delta_bign"     # Unix group owning /projects/bign and /work/hdd/bign
export COURSE_ACCOUNT="bign-delta-gpu"       # Slurm account for GPU jobs (see `accounts`)

# --- Slurm partitions and per-job limits (Delta "Running Jobs" docs) -------
export COURSE_PARTITION_BATCH="gpuA40x4"                  # 4x A40 nodes, max 48 h, charge factor 0.5
export COURSE_PARTITION_INTERACTIVE="gpuA40x4-interactive" # max 1 h, 1 running job per user
export COURSE_GPU="A40"                                   # one A40 is enough for every HW0 run
export COURSE_GPUS_PER_JOB=1
export COURSE_CPUS_PER_JOB=8
export COURSE_MEM="16g"                                   # Delta default is 1 GB/core: too small
export COURSE_TRAIN_TIME="00:20:00"                       # cartpole swingup needs ~5 min on an A40
export COURSE_INTERACTIVE_TIME="00:30:00"

# --- Storage (Delta "Data Management" docs; quotas from `quota`) -----------
#   $HOME = /u/$USER          100 GB, 750k files, daily snapshots, no purge  -> repo + venv
#   /projects/bign            1000 GB, 1.7M files, shared, no purge          -> staff files
#   /work/hdd/bign            1000 GB, 2.55M files, "scratch" for job I/O    -> your runs
#   /work/nvme/bign            500 GB, 2.55M files, fast small-file I/O       -> not needed
export COURSE_PROJECT_DIR="/projects/bign"
export COURSE_STAFF_DIR="/projects/bign/cs498"
export COURSE_WORK_DIR="/work/hdd/bign"       # your runs: $COURSE_WORK_DIR/$USER/runs

# --- Weights & Biases (the course logger and the proof your run happened) --
export COURSE_WANDB_ENTITY="cs498rt-26fall"   # team; its projects are OPEN — no invitation needed
export COURSE_WANDB_PROJECT="hw0-booster"     # https://wandb.ai/cs498rt-26fall/hw0-booster

# --- Term ------------------------------------------------------------------
export COURSE_TERM_START="2026-08-24"         # my_jobs.sh / my_usage.sh history window
